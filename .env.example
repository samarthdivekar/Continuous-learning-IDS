# Copy to .env and adjust. Never commit .env.

# Which processed dataset / label mode the services load
DATASET=cicids2017
LABEL_MODE=multiclass

# Database: SQLite at cache/app.db when unset; PostgreSQL (optionally TimescaleDB) when set:
# DATABASE_URL=postgresql+psycopg2://clgnn:change-me@localhost:5432/clgnn
# Split deployment: public API forwards ML calls here (unset = in-process)
# ML_SERVICE_URL=http://localhost:8001
