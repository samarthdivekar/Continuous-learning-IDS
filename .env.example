# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=clgnn
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clgnn

# Which processed dataset / label mode the services load
DATASET=cicids2017
LABEL_MODE=multiclass

# Local (non-Docker) runs default to SQLite at cache/app.db when unset:
# DATABASE_URL=postgresql+psycopg2://clgnn:change-me@localhost:5432/clgnn
# Split deployment: public API forwards ML calls here (unset = in-process)
# ML_SERVICE_URL=http://localhost:8001
